---
import type { TocHeading } from '../lib/article';

interface Props {
  headings: TocHeading[];
}

const { headings } = Astro.props;
if (headings.length === 0) return;
---
<nav class="mt-8 rounded-2xl border border-stone-200/80 bg-stone-50/80 px-5 py-4" aria-label="Indhold">
  <p class="text-xs font-semibold uppercase tracking-[0.14em] text-moss-700">Indhold</p>
  <ol class="mt-3 space-y-1.5 text-sm text-stone-700">
    {headings.map((h) => (
      <li class:list={[h.depth === 3 && 'pl-4']}>
        <a href={`#${h.slug}`} class="text-sea-700 no-underline hover:underline decoration-moss-300">
          {h.text}
        </a>
      </li>
    ))}
  </ol>
</nav>
