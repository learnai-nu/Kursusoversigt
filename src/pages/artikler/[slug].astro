---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SoftCTA from '../../components/SoftCTA.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import { getCollection } from 'astro:content';
import { articleJsonLd, breadcrumbJsonLd, personJsonLd, JESPER_AUTHOR_NAME, JESPER_AUTHOR_PATH, authorSlug } from '../../lib/seo';
import {
  buildToc,
  formatArticleDate,
  hasDistinctUpdatedDate,
  readingTimeMinutes,
} from '../../lib/article';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map((a) => ({
    params: { slug: a.slug },
    props: { article: a },
  }));
}

const { article } = Astro.props;
const { Content, headings } = await article.render();
const formatted = formatArticleDate(article.data.pubDate);
const showUpdated = hasDistinctUpdatedDate(article.data.pubDate, article.data.updatedDate);
const updatedFormatted = showUpdated && article.data.updatedDate
  ? formatArticleDate(article.data.updatedDate)
  : null;
const minutes = readingTimeMinutes(article.body);
const toc = buildToc(headings);
const authorName = article.data.author;
const authorHref =
  authorSlug(authorName) === 'jesper-gunris-schneider' || authorName === JESPER_AUTHOR_NAME
    ? JESPER_AUTHOR_PATH
    : null;
const crumbs = breadcrumbJsonLd([
  { name: 'Forside', path: '/' },
  { name: 'Artikler', path: '/artikler' },
  { name: article.data.title, path: `/artikler/${article.slug}` },
]);
---
<BaseLayout
  title={article.data.title}
  description={article.data.description}
  ogType="article"
  jsonLd={[
    crumbs,
    personJsonLd(article.data.author),
    articleJsonLd({
      title: article.data.title,
      description: article.data.description,
      slug: article.slug,
      author: article.data.author,
      pubDate: article.data.pubDate,
      updatedDate: article.data.updatedDate,
    }),
  ]}
>
  <div class="container-site py-10">
    <Breadcrumbs items={[
      { label: 'Forside', href: '/' },
      { label: 'Artikler', href: '/artikler' },
      { label: article.data.title },
    ]} />
    <article class="mx-auto max-w-3xl">
      <p class="text-sm text-stone-500">
        {formatted} ·{' '}
        {authorHref ? (
          <a href={authorHref} class="text-sea-700 hover:underline">{authorName}</a>
        ) : (
          authorName
        )}
        {' · '}
        <span>{minutes} min. læsning</span>
      </p>
      {updatedFormatted && (
        <p class="mt-1 text-sm text-stone-500">Opdateret {updatedFormatted}</p>
      )}
      <h1 class="mt-2 text-4xl sm:text-5xl">{article.data.title}</h1>
      <p class="mt-4 text-lg text-stone-600">{article.data.description}</p>
      <ArticleToc headings={toc} />
      <div class="prose-da mt-10">
        <Content />
      </div>
      {article.data.sources?.length > 0 && (
        <section class="mt-12 border-t border-stone-200 pt-6">
          <h2 class="text-xl">Kilder</h2>
          <ul class="mt-3 space-y-2 text-sm text-stone-600">
            {article.data.sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener noreferrer" class="text-sea-700 hover:underline">{s.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <div class="mt-12">
        <SoftCTA campaign="article" />
      </div>
    </article>
  </div>
</BaseLayout>
