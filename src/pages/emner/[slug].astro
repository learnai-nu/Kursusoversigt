---
export const prerender = true;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CourseCard from '../../components/CourseCard.astro';
import SoftCTA from '../../components/SoftCTA.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getAllHubs, getHubBySlug, matchCoursesForHub } from '../../data/hubs';
import { getCollection } from 'astro:content';
import { absoluteUrl, breadcrumbJsonLd, itemListJsonLd, siteUrl } from '../../lib/seo';

export function getStaticPaths() {
  return getAllHubs().map((h) => ({ params: { slug: h.slug } }));
}

const { slug } = Astro.params;
const hub = getHubBySlug(slug!);
if (!hub) {
  return Astro.redirect('/emner');
}

const courses = matchCoursesForHub(hub);
const allArticles = await getCollection('articles');
const articles = hub.relatedArticleSlugs
  .map((s) => allArticles.find((a) => a.slug === s))
  .filter((a): a is NonNullable<typeof a> => Boolean(a));

const pagePath = `/emner/${hub.slug}`;
const crumbs = breadcrumbJsonLd([
  { name: 'Forside', path: '/' },
  { name: 'Emner', path: '/emner' },
  { name: hub.title, path: pagePath },
]);

const collectionPage = {
  '@type': 'CollectionPage',
  '@id': absoluteUrl(pagePath),
  name: hub.title,
  description: hub.description,
  url: absoluteUrl(pagePath),
  isPartOf: { '@id': `${siteUrl()}/#website` },
  inLanguage: 'da-DK',
  about: {
    '@type': 'Thing',
    name: hub.title,
  },
};

const courseList = itemListJsonLd(
  `Kurser · ${hub.title}`,
  pagePath,
  courses.map((c) => ({
    name: c.title,
    path: `/ai-kurser/${c.slug}`,
    description: c.description,
  }))
);
---
<BaseLayout
  title={hub.title}
  description={hub.description}
  canonicalPath={pagePath}
  jsonLd={[crumbs, collectionPage, courseList]}
>
  <div class="container-site py-10">
    <Breadcrumbs items={[
      { label: 'Forside', href: '/' },
      { label: 'Emner', href: '/emner' },
      { label: hub.title },
    ]} />

    <p class="text-xs font-semibold uppercase tracking-[0.16em] text-moss-700">Emnehub</p>
    <h1 class="mt-2 max-w-3xl text-4xl leading-tight sm:text-5xl">{hub.h1}</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-stone-700">{hub.description}</p>

    <div class="prose-da mt-8 max-w-3xl space-y-4">
      {hub.intro.map((p) => (
        <p class="text-stone-700 leading-relaxed">{p}</p>
      ))}
    </div>

    <div class="mt-12 grid gap-8 max-w-3xl">
      {hub.sections.map((section) => (
        <section>
          <h2 class="text-2xl text-paper-ink">{section.heading}</h2>
          <p class="mt-3 text-stone-700 leading-relaxed">{section.body}</p>
        </section>
      ))}
    </div>

    <section class="mt-14">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 class="text-3xl">Kurser i denne hub</h2>
          <p class="mt-1 text-stone-600">
            {courses.length} udvalgte forløb fra kataloget. Ukendt pris betyder, at vi ikke gætter.
          </p>
        </div>
        {hub.catalogFilterHref && (
          <a href={hub.catalogFilterHref} class="text-sm text-sea-700 no-underline hover:underline">
            {hub.catalogFilterLabel || 'Se katalog'} →
          </a>
        )}
      </div>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {courses.map((course) => (
          <div class="flex h-full flex-col gap-2">
            <CourseCard course={course} />
            {hub.courseNotes?.[course.slug] && (
              <p class="px-1 text-xs leading-relaxed text-stone-500">{hub.courseNotes[course.slug]}</p>
            )}
          </div>
        ))}
      </div>
      {courses.length === 0 && (
        <p class="mt-4 text-stone-600">Ingen matchende kurser i kataloget endnu.</p>
      )}
    </section>

    {articles.length > 0 && (
      <section class="mt-14">
        <h2 class="text-3xl">Relaterede artikler</h2>
        <p class="mt-1 text-stone-600">Guider der uddyber valg og kontekst for denne hub.</p>
        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {articles.map((a) => (
            <ArticleCard
              href={`/artikler/${a.slug}`}
              title={a.data.title}
              description={a.data.description}
              date={a.data.pubDate}
              author={a.data.author}
            />
          ))}
        </div>
      </section>
    )}

    <p class="mt-10 text-sm text-stone-600">
      Se også <a href="/emner" class="text-sea-700 hover:underline">alle emnehubs</a>
      {' '}og det fulde <a href="/ai-kurser" class="text-sea-700 hover:underline">kursuskatalog</a>.
    </p>

    <div class="mt-14">
      <SoftCTA
        title={hub.softCta.title}
        text={hub.softCta.text}
        campaign={hub.softCta.campaign}
      />
    </div>
  </div>
</BaseLayout>
